{
  "manifest_version": 3,
  "name": "Extension Pack Hub",
  "version": "1.0.0",
  "description": "Create, share, and install browser extension packs",
  "permissions": [
    "management",
    "tabs",
    "storage",
    "downloads",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://chrome.google.com/webstore/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
